# Database Connection
# Standard PostgreSQL connection string (Neon or local PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:npg_samplepassword@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Authentication & Security
# Secret for signing session cookies (minimum 32 random characters)
SESSION_SECRET="super-secret-at-least-32-chars-long-random-string"

# Admin Login Password
ADMIN_PASSWORD="change_this_to_a_strong_admin_password_in_production"

# Base URL (used for QR code link generation and canonical URLs)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
